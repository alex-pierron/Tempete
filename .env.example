# Device override: cuda | mps | cpu (default: auto, cuda > mps > cpu)
WMKIT_DEVICE=
# Where datasets are downloaded (default: ./data)
WMKIT_DATA_DIR=
# Where checkpoints are cached (default: ./weights)
WMKIT_WEIGHTS_DIR=
# Where evaluation outputs go (default: ./results)
WMKIT_RESULTS_DIR=
# Hugging Face token: REQUIRED for the gated watermark-localization dataset (account must be authorized), also gated text models
HF_TOKEN=

# --- Hackathon (European AI Championship Paris 2026), see docs/hackathon/GUIDE.md ---
# Team API key for submissions and the model-equality endpoints. NEVER commit it.
HACKATHON_API_KEY=
# Evaluation server (leaderboard: <url>/leaderboard_page)
HACKATHON_SERVER_URL=http://34.147.229.55
# Server task id of the watermark localization task (not given in its PDF; fill in once known)
HACKATHON_TASK_WMLOC=34-watermark-localisation-image
# Local data / outputs / submission log (default: ./data/hackathon). On JURECA: the team scratch folder.
HACKATHON_DATA_DIR=
# JURECA (Juelich) accounts, see docs/hackathon/jureca.md
JURECA_USER=
JURECA_TEAM_LEAD=
JURECA_TEAM_FOLDER=
# `Host` alias of ~/.ssh/config used by `python -m hackathon.lab jureca ...` (default: juelich)
# JURECA_SSH_HOST=juelich
# Model equality: answer stores (defaults under artifacts/model_equality/). Team convention, shared on
# main: model_equality/answers.jsonl (scored endpoints) and model_equality/reference_answers.jsonl (ref-*)
# MET_ANSWERS_FILE=model_equality/answers.jsonl
# MET_REFERENCE_ANSWERS_FILE=model_equality/reference_answers.jsonl
