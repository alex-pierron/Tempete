# Copy to .env (never committed) and fill in. Every value here is a placeholder.

# --- Evaluation server of the hackathon ---
# Team API key (header X-API-Key) for submissions and the Model Equality endpoints. Never commit it.
HACKATHON_API_KEY=
# Evaluation server base URL, given by the organisers (leaderboard: <url>/leaderboard_page).
HACKATHON_SERVER_URL=http://hackathon-server.invalid
# Server task id of the watermark localisation task.
HACKATHON_TASK_WMLOC=34-watermark-localisation-image
# Local data, outputs and submission log (default: ./data/hackathon).
HACKATHON_DATA_DIR=

# Hugging Face token: required for the gated watermark-localisation dataset and gated text models.
HF_TOKEN=

# --- Cluster (JURECA, one node of 4 A100), used by the job scripts under solutions/ ---
# Absolute path of the team folder on the cluster scratch file system.
JURECA_TEAM_ROOT=
# Unlearning work folder: data/unlearning/{model.pt,forget_images.npz}, jureca/, output/.
UNL_WORK_DIR=
# Watermark localisation work folders: heads (src/, data/, hf/) and full-resolution network (src/, output/).
WMLOC_HEADS_DIR=
WMLOC_UNET_DIR=

# --- Local analysis scripts (Mac or any CPU machine) ---
# Watermark localisation task folder: release/{train,test}, starter_kit/, models/, cached maps.
WMLOC_DATA_DIR=
# Model Equality: folder with endpoints.csv and the answer stores (raw API answers, not published).
MET_META_DIR=

# Optional device override for wmkit: cuda | mps | cpu (default: auto).
WMKIT_DEVICE=
