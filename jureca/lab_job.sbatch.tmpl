#!/bin/bash
# Lab job on JURECA, generated by `python -m hackathon.lab jureca submit` from this template.
# Do not edit the generated copy: change the spec (experiments/<task>/<id>.toml) or this template.
#
# The header is the organisers' (docs/hackathon/jureca.md): account, reservation, partition and
# one whole node (4 x A100 are visible even with --gres=gpu:1, Slurm does not isolate them), 128
# cores. Upper-case words between double at-signs are filled by
# hackathon.lab.remote.render_job_script; the values already come shell-quoted. One variant of the sweep per GPU, pinned with
# CUDA_VISIBLE_DEVICES, all inside this single job. The job NEVER submits to the evaluation
# server: submission stays a gesture of a human on the laptop (`lab submit RUN --yes`).
#
# Submit FROM THE TASK DIRECTORY (the relative --output path resolves against it); the lab does.

#SBATCH --account=training2666
#SBATCH --reservation=cispahack
#SBATCH --partition=dc-gpu
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=128
#SBATCH --output=output/%j.out
#SBATCH --error=output/%j.err
#SBATCH --job-name=@@JOB_NAME@@
@@TIME_DIRECTIVE@@

# No `set -e`: a failing variant must not kill its siblings; exit codes are collected below.
set -u

TEAM_DIR=@@TEAM_DIR@@
REPO=@@REPO_DIR@@
TASK_DIR=@@TASK_DIR@@
RUN_ROOT=@@RUN_ROOT@@
VARIANT_COUNT=@@VARIANT_COUNT@@

echo "host=$(hostname) job=${SLURM_JOB_ID:-none} group=@@GROUP_ID@@ variants=$VARIANT_COUNT"

# Shared caches (UV_CACHE_DIR, HF_HOME...) are exported by the team scripts in ~/.bashrc.
if [ -f "$HOME/.bashrc" ]; then
    set +u
    source "$HOME/.bashrc" >/dev/null 2>&1 || true
    set -u
fi

cd "$TASK_DIR" || { echo "task directory missing: $TASK_DIR" >&2; exit 3; }
if [ ! -f .venv/bin/activate ]; then
    echo "no .venv in $TASK_DIR (hackathon_setup.sh not run for this task?)" >&2
    exit 3
fi
source .venv/bin/activate
if [ ! -d "$REPO/src/hackathon" ]; then
    echo "code not synced in $REPO: run 'python -m hackathon.lab jureca sync'" >&2
    exit 3
fi

export PYTHONPATH="$REPO/src"
export PYTHONUNBUFFERED=1
# The submission log and defaults of hackathon.common live next to the team folder, not in the repo.
export HACKATHON_DATA_DIR="${HACKATHON_DATA_DIR:-$TEAM_DIR/hackathon_data}"

# One GPU per variant when the node shows enough of them. If Slurm starts isolating GPUs (one
# visible), fall back to running the variants one after the other instead of pinning an
# index that does not exist.
GPU_COUNT=$(nvidia-smi -L 2>/dev/null | wc -l | tr -d ' ')
nvidia-smi --query-gpu=index,name,memory.total --format=csv,noheader 2>/dev/null || true
python -c "import torch; print('torch', torch.__version__, 'cuda', torch.cuda.is_available())" || true
if [ "$GPU_COUNT" -ge "$VARIANT_COUNT" ]; then
    PARALLEL=1
else
    PARALLEL=0
    echo "warning: $GPU_COUNT GPU(s) visible for $VARIANT_COUNT variant(s): running them in sequence" >&2
fi

# run_variant OUT_DIR GPU_INDEX STEP...   each STEP is one shell-quoted command line.
# exit_code is written LAST: its presence means the variant is over (the lab polls for it).
run_variant() {
    local out="$1" gpu="$2"
    shift 2
    mkdir -p "$out"
    (
        if [ "$GPU_COUNT" -gt 0 ]; then
            export CUDA_VISIBLE_DEVICES=$((gpu % GPU_COUNT))
        fi
        cd "$REPO" || exit 1
        date -u +%Y-%m-%dT%H:%M:%SZ >"$out/started_at"
        status=0
        for step in "$@"; do
            printf '+ %s\n' "$step" >>"$out/stdout.log"
            bash -c "$step" >>"$out/stdout.log" 2>>"$out/stderr.log"
            status=$?
            if [ "$status" -ne 0 ]; then
                break
            fi
        done
        date -u +%Y-%m-%dT%H:%M:%SZ >"$out/finished_at"
        echo "$status" >"$out/exit_code"
    ) &
    if [ "$PARALLEL" -eq 0 ]; then
        wait
    fi
}

@@VARIANT_CALLS@@

wait

overall=0
for out in @@OUT_DIRS@@; do
    code=$(cat "$out/exit_code" 2>/dev/null || echo 1)
    echo "variant $out exit_code=$code"
    if [ "$code" -ne 0 ]; then
        overall=1
    fi
done
echo "done: $RUN_ROOT"
exit "$overall"
